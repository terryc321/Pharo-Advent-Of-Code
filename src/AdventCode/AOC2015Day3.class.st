{ #category : 'as yet unclassified' }
AOC2015Day3 >> puzzleInputParsed [
	^ self notYetImplemented 

	
]

{ #category : 'as yet unclassified' }
AOC2015Day3 >> puzzlePart1 [	
^ 'Santa is delivering presents to an infinite two-dimensional grid of houses.

He begins by delivering a present to the house at his starting location, and then an elf at the North Pole calls him via radio and tells him where to move next. Moves are always exactly one house to the north (^), south (v), east (>), or west (<). After each move, he delivers another present to the house at his new location.

However, the elf back at the north pole has had a little too much eggnog, and so his directions are a little off, and Santa ends up visiting some houses more than once. How many houses receive at least one present?

For example:

> delivers presents to 2 houses: one at the starting location, and one to the east.
^>v< delivers presents to 4 houses in a square, including twice to the house at his starting/ending location.
^v^v^v^v^v delivers a bunch of presents to some very lucky children at only 2 houses.
 
'

]

{ #category : 'as yet unclassified' }
AOC2015Day3 >> puzzlePart2 [	
^ ' The next year, to speed up the process, Santa creates a robot version of himself, Robo-Santa, to deliver presents with him.

Santa and Robo-Santa start at the same location (delivering two presents to the same starting house), then take turns moving based on instructions from the elf, who is eggnoggedly reading from the same script as the previous year.

This year, how many houses receive at least one present?

For example:

^v delivers presents to 3 houses, because Santa goes north, and then Robo-Santa goes south.
^>v< now delivers presents to 3 houses, and Santa and Robo-Santa end up back where they started.
^v^v^v^v^v now delivers presents to 11 houses, with Santa going one direction and Robo-Santa going the other.


'

]

{ #category : 'as yet unclassified' }
AOC2015Day3 >> solution1Part1 [

	| d p tot i |
	"d dictionary of points x@y , p be current position . i index in string"
	i := 0.
	d := Dictionary new.
	p := 0 asPoint.
	d at: p put: 1.
	"if point not registerd in dictionary then put 1 else increment that position"
	self puzzleInput do: [ :e |
			| q w n |
			i := i + 1.
			q := p.
			w := false.
			e = $^ ifTrue: [
					p := p + (0 @ 1).
					w := true ].
			e = $< ifTrue: [
					p := p + (-1 @ 0).
					w := true ].
			e = $> ifTrue: [
					p := p + (1 @ 0).
					w := true ].
			e = $v ifTrue: [
					p := p + (0 @ -1).
					w := true ].
			"if w not true then we encountered bad character in string -- error out"
			w ifFalse: [
				Error signal: 'bad input character at index ' , i asString ].
			"record each time we hit a particular point x@y"
			n := (d at: p ifAbsent: 0) + 1.
			d at: p put: n ].
	"iterate over keys in dictionary if any point counted once or more add that point to total"
	tot := 0.
	d keysDo: [ :key |
			| n |
			n := d at: key.
			n > 0 ifTrue: [ tot := tot + 1 ] ].
	"total number of houses got atleast 1 present"
	^ tot
]

{ #category : 'as yet unclassified' }
AOC2015Day3 >> solution1Part2 [

	| stream route route2 index point point2 |
	index := 0.
	point := 0 asPoint.
	point2 := 0 asPoint.
	"remember addresses santa been using route"
	route := AOC2015Day3Route new.
	route2 := AOC2015Day3Route new.
	route deliverPresentTo: point.
	route2 deliverPresentTo: point2.
	"use puzzle input as a stream "
	stream := self puzzleInput readStream.
	[ stream atEnd ] whileFalse: [
			| char valid char2 |
			char := stream next.
			index := index + 1.
			valid := false.
			char = $^ ifTrue: [
					point := point + (0 @ 1).
					valid := true ].
			char = $< ifTrue: [
					point := point + (-1 @ 0).
					valid := true ].
			char = $> ifTrue: [
					point := point + (1 @ 0).
					valid := true ].
			char = $v ifTrue: [
					point := point + (0 @ -1).
					valid := true ].
			"if not valid then encountered bad character in string -- error out with index"
			valid ifFalse: [
				Error signal: 'bad input character at index ' , index asString ].
			route deliverPresentTo: point.
			stream atEnd ifFalse: [ 
			"duplicate for point2 and route2"
			char := stream next.
			index := index + 1.
			valid := false.
			char = $^ ifTrue: [
					point2 := point2 + (0 @ 1).
					valid := true ].
			char = $< ifTrue: [
					point2 := point2 + (-1 @ 0).
					valid := true ].
			char = $> ifTrue: [
					point2 := point2 + (1 @ 0).
					valid := true ].
			char = $v ifTrue: [
					point2 := point2 + (0 @ -1).
					valid := true ].
			"if not valid then encountered bad character in string -- error out with index"
			valid ifFalse: [
				Error signal: 'bad input character at index ' , index asString ].
			route2 deliverPresentTo: point2.
			 ]].
	^ (route combineRoute: route2) tabulateAtleastOnePresent 
	

]

{ #category : 'as yet unclassified' }
AOC2015Day3 >> solution2Part1 [

	| stream santa |
	santa := AOC2015Day3Santa new.
	stream := self puzzleInput readStream.
	[ stream atEnd ] whileFalse: [
			| char |
			char := stream next.
			santa tell: char].
	^ santa ask 
	

]

{ #category : 'as yet unclassified' }
AOC2015Day3 >> solution2Part2 [

	| stream santa roboSanta route |
	santa := AOC2015Day3Santa new.
	roboSanta := AOC2015Day3Santa new.
	"both santas record 0@0 as delivered to already"
	stream := self puzzleInput readStream.
	[ stream atEnd ] whileFalse: [
			| char |
			char := stream next.
			santa tell: char.
			stream atEnd ifFalse: [
					char := stream next.
					roboSanta tell: char ] ].
	"ask both santas how many locations got atleast one present"
	route := santa combineSantas: roboSanta .
	^ route tabulateAtleastOnePresent. 
	

]
