AOC2015Day18 >> inputGrid2 [
"corner lights stuck on"
|g w h|
g := self gridFromLines: (self input2).
w := g width.
h := g height.
g atColumn: 1 atRow: 1 put: 1. 	                
g atColumn: w atRow: 1 put: 1. 	                
g atColumn: 1 atRow: h put: 1. 	               
g atColumn: w atRow: h put: 1. 	                 
^ g

]

{ #category : 'as yet unclassified' }
AOC2015Day18 >> neighbours: aPoint grid: g [ 
| x y w h r valid |
r := OrderedCollection new.
x := aPoint x.
y := aPoint y.
w := g width.
h := g height.

r add: (x+1)@(y+1).
r add: (x-0)@(y+1).
r add: (x-1)@(y+1).

r add: (x+1)@(y+0).
"r add: (x-0)@(y+0). - the square itself" 
r add: (x-1)@(y+0).

r add: (x+1)@(y-1).
r add: (x-0)@(y-1).
r add: (x-1)@(y-1).

"select squares that are on the grid and not the square itself"
valid := r select: [:aPt | 
  | px py |
  px := aPt x.
  py := aPt y.
  px >= 1 and:[ px <= w and: [ py >= 1 and: [py <= h]]]].

^ valid collect: [:aPt | 
   | px py | 
   px := aPt x.
   py := aPt y.
   "{px . py . g atColumn: px atRow: py}"
   g atColumn: px atRow: py
   ]. 

]

{ #category : 'as yet unclassified' }
AOC2015Day18 >> neighboursOn: aPoint grid: g [ 
| pts onPts | 
"just get a count of number 1's on grid around aPoint"
pts := self neighbours: aPoint grid:g .
onPts := pts select:[ :e | e = 1 ].
^ onPts size.
]

