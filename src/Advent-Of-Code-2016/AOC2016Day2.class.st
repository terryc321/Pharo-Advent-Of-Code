Class {
	#name : 'AOC2016Day2',
	#superclass : 'Object',
	#category : 'Advent-Of-Code-2016',
	#package : 'Advent-Of-Code-2016'
}

{ #category : 'accessing' }
AOC2016Day2 >> input [ 
| raw |
raw := self inputRaw.
^ raw splitOn: Character cr.

]

{ #category : 'accessing' }
AOC2016Day2 >> inputRaw [ 
^ '



'
]

{ #category : 'as yet unclassified' }
AOC2016Day2 >> part1 [

	| in code hand |
	in := self input.
	code := OrderedCollection new.
	hand := AOC2016Day2Hand new.
	hand centre.
	in do: [ :line |
			line do: [ :ch |
					ch = $R ifTrue: [ hand moveRight ].
					ch = $L ifTrue: [ hand moveLeft ].
					ch = $U ifTrue: [ hand moveUp ].
					ch = $D ifTrue: [ hand moveDown ] ].
			code add: hand keypad ].
	^ code.

]

{ #category : 'as yet unclassified' }
AOC2016Day2 >> part2 [

	| in code hand |
	in := self input.
	code := OrderedCollection new.
	hand := AOC2016Day2Hand new centre.
	in do: [ :line |
			line do: [ :ch |
					ch = $R ifTrue: [ hand := hand right ] ifFalse:[
					ch = $L ifTrue: [ hand := hand left ] ifFalse:[
					ch = $U ifTrue: [ hand := hand up ] ifFalse:[
					ch = $D ifTrue: [ hand := hand down ] ifFalse: [ Error signal: 'direction not recognised' ]]]]].
			code add: hand keypad ].
	^ code.

]
